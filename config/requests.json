{
  "anthropicMessages": {
    "schema": {
      "method": "POST",
      "host": "api.anthropic.com",
      "path": "/v1/messages",
      "headers": {
        "x-api-key": "<%= iparam.anthropic_api_key %>",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      }
    }
  },
  "openaiResponses": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.openai_host %>",
      "path": "/v1/responses",
      "headers": {
        "Authorization": "Bearer <%= iparam.openai_api_key %>",
        "Content-Type": "application/json"
      }
    }
  },
  "copilotChatCompletions": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.copilot_endpoint_host %>",
      "path": "/openai/deployments/<%= iparam.copilot_deployment %>/chat/completions?api-version=<%= iparam.copilot_api_version %>",
      "headers": {
        "api-key": "<%= iparam.copilot_api_key %>",
        "Content-Type": "application/json"
      }
    }
  },
  "freshserviceAddNote": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.freshservice_domain %>",
      "path": "/api/v2/tickets/<%= context.ticket_id %>/notes",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshservice_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "freshserviceKbSearch": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshservice_domain %>",
      "path": "/api/v2/solutions/articles/search?search_term=<%= context.search_term %>&per_page=1",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshservice_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  },
  "freshserviceTicketFields": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.freshservice_domain %>",
      "path": "/api/v2/ticket_form_fields",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.freshservice_api_key + ':X') %>",
        "Content-Type": "application/json"
      }
    }
  }
}
